            "value" : "About Champz"
          }
        }
      }
    },
    "about_champz_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champz is the premier platform for sports enthusiasts, dedicated to hosting exceptional football tournaments and delivering top-notch services like full media coverage, stats tracking, and professional refereeing. Our mission is to elevate amateur football by creating unforgettable experiences that foster community spirit and inspire players to excel. Whether you're an athlete, a fan, or a partner, Champz offers a vibrant ecosystem where passion for the game thrives."
          }
        }
      }
    },
